{
  "name": "cashtrack-ui",
  "version": "0.5.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "generate:changelog": "node scripts/generate-changelog.js",
    "build": "npm run generate:changelog && tsc && vite build",
    "build-showcase": "npm run generate:changelog && vite build --config vite.showcase.config.ts",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --coverage",
    "release": "npm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "latest",
    "@open-wc/testing": "^5.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "playwright": "latest",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "latest"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "lit": "^3.3.3"
  }
}
